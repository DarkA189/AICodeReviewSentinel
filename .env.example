# ============================================================
# AI Code Review Sentinel — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ------------------------------------------------------------
# LLM Provider (choose one or configure both)
# ------------------------------------------------------------

# Anthropic Claude (recommended)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (alternative fallback)
OPENAI_API_KEY=sk-...

# Which LLM provider to use: "anthropic" | "openai"
LLM_PROVIDER=anthropic

# Model to use (defaults below)
# Anthropic: claude-opus-4-5, claude-sonnet-4-5, claude-haiku-3-5
# OpenAI: gpt-4o, gpt-4-turbo, gpt-3.5-turbo
LLM_MODEL=claude-sonnet-4-5

# ------------------------------------------------------------
# Semgrep (optional — enhances security scanning)
# ------------------------------------------------------------
# Set to "true" to enable Semgrep CLI scanning (requires semgrep installed)
# Falls back to pattern-based analysis if not available
ENABLE_SEMGREP=false

# Semgrep timeout in seconds (default: 30)
SEMGREP_TIMEOUT=30

# ------------------------------------------------------------
# App Config
# ------------------------------------------------------------
# Max code size in characters (default: 50000)
MAX_CODE_SIZE=50000

# Rate limiting: max reviews per minute per IP (default: 10)
RATE_LIMIT_PER_MINUTE=10

# Enable request logging (default: false)
ENABLE_REQUEST_LOGGING=false

# ------------------------------------------------------------
# Next.js
# ------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-random-secret-here
